{
  "name": "sui-local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Sui agent with isolated wallet keys and persistent Walrus Memory",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "agent": "node scripts/check-node.mjs && tsx src/index.ts",
    "dev": "npm run agent",
    "start": "node scripts/check-node.mjs && node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "register": "tsx scripts/register-agent.mjs",
    "set-key": "node scripts/set-key.mjs",
    "doctor": "node scripts/check-node.mjs && tsx src/index.ts doctor",
    "setup": "bash setup.sh",
    "deps:check": "ncu",
    "deps:update": "ncu -u && npm install",
    "skills:list": "skills add mystenlabs/skills --list",
    "skills:install": "bash scripts/install-skills.sh",
    "sui:install": "bash scripts/install-sui.sh",
    "walrus:install": "bash scripts/install-walrus.sh"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "0.1.6",
    "@mysten/sui": "2.31.0",
    "@scure/bip39": "2.4.0",
    "dotenv": "17.4.2",
    "openai": "7.15.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.12.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "skills": "1.7.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
